# --- Gemini ---
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- API (runs natively on host) ---
API_PORT=8080
API_LOG_LEVEL=info
API_CORS_ORIGINS=http://localhost:5173

# --- SurrealDB (runs in Docker, exposed on localhost) ---
SURREAL_URL=http://localhost:8000
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=rshb
SURREAL_DB=svoe_rodnoe

# --- Web (Vite dev server) ---
VITE_API_URL=http://localhost:8080
VITE_APP_NAME="Свое Родное · Calendar"

# --- Tagging ---
TAGGING_BATCH_SIZE=20
TAGGING_RATE_LIMIT_PER_MIN=15
TAGGING_DRY_RUN=false

# --- Paths (optional overrides) ---
# Leave these UNSET in dev — config.Load() auto-detects the repo root by
# walking upward from cwd, so ./data/* and ./infrastructure/* are always
# found correctly regardless of where you run `go run` from.
# SCHEMA_PATH=
# EVENTS_YAML_PATH=
# XLSX_PATH=
