# =====================================================================
#  PRODUCTION env template — copy to `.env.production`, fill, deploy.
#
#  Used by docker-compose.prod.yml.
#  Do NOT commit the real `.env.production`. .gitignore already excludes it.
#
#  Cloudify usage:
#    The same file works as a Cloudify secrets bundle. Mount it into the
#    deployment dir or override individual keys via Cloudify inputs.
# =====================================================================

# ── PUBLIC URL the user types in their browser ──────────────────────
# Used for CORS and (optionally) baked into the Vite build as VITE_API_URL.
# Leave PUBLIC_API_URL empty for same-origin deploys (FE → relative /api).
# Set both PUBLIC_API_URL and API_CORS_ORIGINS if you front-end and back-end
# live on different hostnames.
PUBLIC_APP_NAME=Свое Родное · Calendar
PUBLIC_API_URL=
API_CORS_ORIGINS=https://kiberfarmers.example.com

# ── Public-facing HTTP port the `web` container exposes ─────────────
# Put a TLS-terminating reverse proxy in front of this (Caddy, Nginx,
# Cloudify-managed). Do NOT expose 80 directly to the internet in prod.
WEB_PORT=8080

# ── Gemini ──────────────────────────────────────────────────────────
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# ── SurrealDB credentials ───────────────────────────────────────────
# These secure root access. Pick strong values; the DB port is never
# published to the host, so brute-force is gated by network access.
SURREAL_USER=root
SURREAL_PASS=replace-me-with-strong-password
SURREAL_NS=rshb
SURREAL_DB=svoe_rodnoe

# ── API runtime knobs ───────────────────────────────────────────────
API_PORT=8080
API_LOG_LEVEL=info

# ── Tagging / embedding ─────────────────────────────────────────────
# Conservative defaults; bump if you have a paid Gemini tier.
TAGGING_BATCH_SIZE=20
TAGGING_RATE_LIMIT_PER_MIN=15
TAGGING_DRY_RUN=false
EMBED_RATE_LIMIT_PER_MIN=60
EMBED_WORKERS=6

# ── Authentication ──────────────────────────────────────────────────
# First-admin bootstrap. Read ONLY on first boot when no admin exists in DB.
# After the first admin is created, changing these is a no-op. Use a strong
# password — bcrypt cost 12 hash is stored in SurrealDB.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Session TTL: fixed expiry from login time. 168h = 7 days.
AUTH_SESSION_TTL_HOURS=168

# Login rate limit (per-username, sliding window, in-process counter):
#   N failures within W minutes → 429. Resets on successful login.
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW_MIN=15
