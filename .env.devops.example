# =====================================================================
#  DevOps Operator — env template
#  ----------------------------------------------------------------
#  Internal API that wraps a *whitelisted* subset of Coolify operations
#  so AI agents (Claude Code etc.) can drive deployments without ever
#  touching docker / shell / arbitrary HTTP.
#
#  Copy to .env.devops and fill in. NEVER commit the real file.
#  NEVER expose this service to the public internet.
# =====================================================================

# ---- Server ---------------------------------------------------------
DEVOPS_PORT=9090
DEVOPS_BIND_ADDR=127.0.0.1   # bind to loopback unless you know what you're doing
DEVOPS_LOG_LEVEL=info        # debug | info | warn | error

# ---- Internal auth --------------------------------------------------
# Shared-secret bearer token required on every /deploy /status /logs /restart
# call to this service. Generate one with:  openssl rand -hex 32
DEVOPS_INTERNAL_TOKEN=replace-me-openssl-rand-hex-32

# ---- Coolify API ----------------------------------------------------
COOLIFY_URL=https://coolify.permiraspb.org
COOLIFY_PROJECT_UUID=fj1cucm7nasatsa2v9dkammk

# Coolify personal access token.
# Create in Coolify UI:  Profile → Keys & Tokens → API tokens
# Required scopes: read + write on applications & deployments.
COOLIFY_TOKEN=

# ---- HTTP client ----------------------------------------------------
COOLIFY_HTTP_TIMEOUT_SECONDS=30

# ---- Whitelist ------------------------------------------------------
# Comma-separated UUIDs of Coolify applications this operator is allowed
# to act on. EMPTY means deny everything (safe default).
# Example: DEVOPS_ALLOWED_APPS=abc123,def456
DEVOPS_ALLOWED_APPS=
